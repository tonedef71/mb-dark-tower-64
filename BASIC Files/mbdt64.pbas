rem === boot strap ===
@l_boot_strap
poke53280,11:poke53281,0:poke646,12
poke657,128:rem disable case toggle
dimmp$(3),kn$(3),fc$(1),df$(3)
dimte(3,19),kc(3),kt(3),ki(3),kk(17),ky(3)
dimbz(4),tb(4),ru(4),dd(2),bu(2),bl%(5),fi%(1)
kn$(0)="arisilon":kn$(1)="brynthia":kn$(2)="durnin":kn$(3)="zenon"
df$(0)="standard":df$(1)="harder":df$(2)="random":df$(3)="trainer"
kc(0)=150:kc(1)=159:kc(2)=158:kc(3)=30
kt(0)=158:kt(1)=158:kt(2)=154:kt(3)=5
ky$="bsgbgssbgsgbgbsgsb":rem the six different key sequence combinations
!- 1=safe,2=lost,3=plague,4=brigands,5=dragon,6=cursed
ew$="5161234123412341234516":rem the event wheel
wh$=chr$(5):yw$=chr$(158):cy$=chr$(159):rd$=chr$(28):rl$=chr$(150)
og$=chr$(129):vi$=chr$(156):gd$=chr$(151):gl$=chr$(155):gy$=chr$(152)
dg$=chr$(30):lg$=chr$(153):br$=chr$(149):bd$=chr$(31):bl$=chr$(154)
pw$=chr$(120):dr$=chr$(92):uk$=chr$(166):te$=chr$(46)
rt$=chr$(13):cs$=chr$(147)
ba$=chr$(95):ua$=chr$(94):gt$=chr$(62)
rn$=chr$(18):rf$=chr$(146):rem rvs on/off characters
h1$=yw$:h2$=og$:h3$=wh$:h4$=cy$:tc$=gl$
sp$="                                        ":rem 40 spaces
tt$="dark tower":rem game title
printcs$tc$"initializing..."
bu(0)=2:bu(1)=4:bu(2)=8:rem initial ordering of swappable buildings
fori=0to19:read a:fork=0to3:te(k,i)=a:ifk>0andi=0thente(k,i)=0
nextk:nexti:rem init all kingdoms
rem === initialize game state ===
@l_reset_state
ni=1:gosub@p_sound_silence:rem init sound
ky(0)=1:fori=1to3:ky(i)=0:nexti:rem reset key flags
fori=0to2:dd(i)=-1:nexti:rem reset dragon data
su=0:bs=0:hl=0:pg=0:sw=0:wz=0:tu%=0:sc%=0:vc%=0
hk=0:ck=0:tk=0:px=1:py=1:ox=px:oy=py
cv=0:dg=0:dw=0:fb=0:gm%=0:ko$=""
rem === title screen ===
@l_title_screen
tl$=tt$:l%=len(tl$):if(l%and1)=0thenl%=l%+1:tl$=tl$+" "
t%=(len(sp$)-l%)/2
printcs$;
printleft$(sp$,t%+(l%-5)/2);:fori=1to5:a=iand1
ifa=0thenprint" ";
ifa=1thenprintog$rn$" "rf$;
nexti:print
printleft$(sp$,t%+(l%-5)/2)og$rn$left$(sp$,5)rf$
fori=1to2:printleft$(sp$,t%+(l%-3)/2)og$rn$left$(sp$,3)rf$:nexti
printleft$(sp$,t%)yw$rn$tl$rf$
print:printtc$
printtab(5)"the scepter has been stolen by"
printtab(5)"the evil tyrant king!"
print:printtab(5)"find the three magic keys and"
printtab(5)"storm the dread "h1$tt$tc$"!"
gosub@p_music_valkyries:rem intro music
print:printtab(14)h4$"play level:":print
aa$="":c$="":fori=0to3:a$=left$(df$(i),1):aa$=aa$+a$
c$=rn$+h1$+a$+rf$+tc$+right$(df$(i),len(df$(i))-1)
printtab(15)c$:nexti
print:printtab(14)h4$"choose: "tc$;
gosub@p_select_char
fori=1tolen(aa$):ifmid$(aa$,i,1)=a$thendf=i-1
nexti
@p_seed_prng:rem seed the prng
print:print:printgy$"preparing new game...";
gosub@p_rnd_key_order:rem randomize gate lock's key code
rem === game level settings ===
@l_set_diff
wr=10:fd=25:gd=30:rem common game settings
ifdf=0thenlo=17:hi=32:gosub@p_random_range:ew=int(r)
ifdf=1thenlo=33:hi=64:gosub@p_random_range:ew=int(r)
ifdf=2thenlo=17:hi=64:gosub@p_random_range:ew=int(r)
ifdf=3thenko$="gsb":ew=16:py=4:oy=py:su=1:bs=1:hl=1:sw=1:pg=1:wz=1
ifdf=3thenfori=1to3:ky(i)=1:nexti:rem grant all keys
rem === shuffle certain buildings within each kingdom ===
@l_shuffle_kingdom_buildings
fork=0to3:fori=0to2
lo=0:hi=2:gosub@p_random_range:r=int(r)
t=bu(i):bu(i)=bu(r):bu(r)=t:nexti:rem shuffle
l=0:fori=0to19:a=te(k,i):if(aand14)>0thente(k,i)=bu(l):l=l+1
nexti:nextk
rem === place keys ===
@l_place_keys
fork=1to3
j=0:fori=0to19:if0=(te(k,i)and7)thenkk(j)=i:j=j+1
nexti:rem isolate tomb,ruins,terrain from location types
!- shuffle the isolated territories
lo=0:hi=17:fori=lotohi:gosub@p_random_range:r=int(r)
t=kk(i):kk(i)=kk(r):kk(r)=t:nexti
ki(k)=kk(0):rem select the top element
nextk
rem === clear maps ===
@l_clear_maps
fork=0to3:fori=0to19
te(k,i)=te(k,i)and127:rem clear visited bit
nexti:nextk
rem === main game loop ===
@l_main_loop_start
!- gm% game state: 0=playing;1=restarting;2=ended;3=ending
ifgm%=3thengosub@p_game_over
ifgm%>0thenongm%goto@l_reset_state,@l_end
gosub@p_main_display:rem main screen
gosub@p_action_prompt:rem action prompt
pokes+4,0:dl=.01:gosub@p_sleep:rem release gate v1
goto@l_main_loop_start
rem === end ===
@l_end
end
