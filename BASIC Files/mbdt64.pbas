return
rem === hit return key to continue ===
@p_any_key
print:printtc$"hit "h1$rn$"return"rf$tc$" to continue"
aa$=rt$:gosub@p_select_char
return
rem === derive current index from current location ===
@p_loc_to_idx
ci=(py-1)*5+(px-1)
return
rem === current location ===
@p_location
gosub@p_loc_to_idx:vi=te(ck,ci)and128:vt=te(ck,ci)and31
ifvt=0thenlo$="terrain"
ifvt=1thenlo$="citadel"
ifvt=2thenlo$="sanctuary"
ifvt=4thenlo$="bazaar"
ifvt=8thenlo$="tomb"
ifvt=16thenlo$="ruin"
return
rem === display key pressed ===
@p_print_pressed_key
printwh$">"h1$a$wh$"<":dl=0.66:gosub@p_sleep
return
rem === select a char option ===
@p_select_char
poke198,0:rem empty the keyboard buffer
@l_select_char
geta$:ifa$=""thengosub@p_music_ambient:goto@l_select_char
i=0:ln%=len(aa$)
@l_select_char_check
ab$=mid$(aa$,i+1,1):ifab$<>a$andi<ln%theni=i+1:goto@l_select_char_check
ifi<ln%andasc(a$)>32thengosub@p_print_pressed_key
ifi<ln%thengoto@l_select_char_return
goto@l_select_char
@l_select_char_return
return
rem === skip an event ===
@p_skip_event
sk%=0:ifck=hkandox=1andoy=1thensk%=-1:rem skip events on this turn
return
rem === compute key count total ===
@p_key_total
tk=ky(1)+ky(2)+ky(3)
return
rem === format a key name ===
@p_key_name
ifki%=0thenkt$=br$+"brass key"
ifki%=1thenkt$=gl$+"silver key"
ifki%=2thenkt$=yw$+"gold key"
return
rem === warrior(s) ===
@p_warriors_print
print"warrior";:ifwr%<>1thenprint"s";
return
rem === print inventory ===
@p_show_inventory
ifsu+bs+hl+sw+pg+wz=0thenc$=gy$+"(none)":goto@l_show_inventory_return
c$=""
ifpg=1thenc$=c$+h1$+rn$+"p"+rf$+wh$+"egasus "
ifwz=1thenc$=c$+gy$+"wi"+h1$+rn$+"z"+rf$+gy$+"ard "
ifsu=1thenc$=c$+vi$+"scout "
ifbs=1thenc$=c$+bl$+"beast "
ifhl=1thenc$=c$+bd$+"healer "
ifsw=1thenc$=c$+og$+"sword"
print:printc$tc$
@l_show_inventory_return
return
rem === compute final score ===
@p_score
iffb=0thengoto@l_print_score
a=(ew-17):a=a^2:a=int(a*0.02)+ew
sc%=176+sc%+a-(tu%+fw):rem adjust score
@l_print_score
a=2:ifsgn(sc%)<0thena=a-1:rem handle a negative score
printh3$mid$(str$(sc%),a)tc$;
return
rem === is army running low? ===
@p_is_army_low
lw%=(4>wr):rem set lw% flag if less than four warriors remaining
return
rem === is gold running low? ===
@p_is_gold_low
lg%=(4>gd):rem set lg% flag if less than four gold remaining
return
rem === consume food ===
@p_eat_food
fc=int(wr/15):iffc<1thenfc=1
fd=fd-fc:iffd<0thenfd=0
return
rem === is food low? ===
@p_is_food_low
lf%=(4>fd-int(wr/15+.5)):rem set lf% flag if less than four food remaining
return
rem === starvation ===
@p_starvation_check
gosub@p_is_food_low:iflf%thengosub@p_sound_low_food:rem low food sound
iffd>0thenreturn
printrd$"starvation! "tc$;
gosub@p_music_funeral_march:rem funeral march sound
ls=1:wr=wr-ls:gosub@p_adjust_gold_carried:rem adjust gold carried
print"lost "yw$mid$(str$(ls),2)tc$" ";:wr%=ls:gosub@p_warriors_print:print"!"
gosub@p_army_eliminated_check
ifwr>0thendl=2:gosub@p_sleep
return
rem === army eliminated check ===
@p_army_eliminated_check
ifwr>=1thengoto@l_army_eliminated_return
wr=0:gm%=3:rem game over in progress
printrd$"defeat!"tc$" thy whole army has perished"
gosub@p_any_key:rem hit return to continue
@l_army_eliminated_return
return
rem === undo last turn ===
@p_undo_turn
tu%=tu%-1:rem decrement turn counter
fd=fd+fc:rem restore consumed food
return
rem === adjust amount of gold being carried ===
@p_adjust_gold_carried
mx=wr*6:ifbs=1thenmx=mx+50
ifgd>mxthengd=mx
return
rem === gold treasure check ===
@p_gold
g=0:gosub@p_dice_pct:rem percentile roll for gold
ifr>trthengoto@l_other_treasures:rem proceed to check for non-gold treasure
@l_gold_amount
lo=gl%:hi=gh%:gosub@p_random_range:g=int(r):rem compute amount of gold found
gd=gd+g:gosub@p_adjust_gold_carried
printh1$mid$(str$(g),2)tc$" gold gained"
@l_other_treasures
!- key/pegasus/sword/wizard
rem === key treasure check ===
gosub@p_key_here_check
ifkpthengosub@p_key_found:goto@l_treasure_check_return:rem key is present here
rem === non-gold treasure check ===
iftr<1thengoto@l_treasure_check_return:rem no treasure to be found here
iftr>50thentr=25:rem non-gold treasures should be rare
gosub@p_dice_pct:rem re-roll percentile roll for non-gold treasure
ifr>trthengoto@l_treasure_check_return
tq%=0:fori=0to2:tr(i)=0:nexti
ifpg=0thentr(tq%)=1:tq%=tq%+1
ifsw=0thentr(tq%)=2:tq%=tq%+1
ifwz=0thentr(tq%)=3:tq%=tq%+1
iftq%<1thengoto@l_treasure_check_return:rem no treasures available
lo=0:hi=tq%-1:gosub@p_random_range
ontr(r)gosub@p_pegasus_found,@p_sword_found,@p_wizard_found
@l_treasure_check_return
return
@p_key_here_check
rem === is there a key at this location? ===
gosub@p_key_total
kp=0:ifck=hkortk=3thenreturn
gosub@p_loc_to_idx:ifki(ck)=cithenkp=-1
return
rem === robbed ===
@p_robbed
sg=0:ifgd>0thensg=int(gd/4):ifsg<1thensg=1
sl=0:ifwr>1thensl=int(wr/4):ifsl<1thensl=1
ifsl+sg<1thengoto@l_robbed_return
gd=gd-sg:ifgd<0thengd=0
ifsl>0thenwr=wr-sl:gosub@p_adjust_gold_carried:rem adjust gold carried
ifsl>0thenprinth1$mid$(str$(sl),2)tc$" ";:wr%=sl:gosub@p_warriors_print
ifsg>0andsl>0thenprint" and ";
ifsg>0thenprinth1$mid$(str$(sg),2)tc$" gold";
print" lost"
!- gosub@p_any_key:rem hit return to continue
@l_robbed_return
return
rem === awarded ===
@p_awarded
lo=17:hi=ew:gosub@p_random_range:wg%=int(r/4):wr=wr+wg%
printh1$mid$(str$(wg%),2)tc$" ";:wr%=wg%:gosub@p_warriors_print
mx=wr*6:ifbs=1thenmx=mx+50
ifgd>=mxthengoto@l_awarded_return
lo=0:hi=(mx-gd)/4:gosub@p_random_range:gg%=int(r)
ifgg%>0thengd=gd+gg%:print" and "h1$mid$(str$(gg%),2)tc$" gold";
print" gained";
@l_awarded_return
print
!- gosub@p_any_key:rem hit return to continue
return
rem === main display ===
@p_main_display
gosub@p_key_total:rem compute total keys acquired
gosub@p_location:rem derive location info
fory=3to0step-1:mp$(3-y)=""
!- print".";:rem print progress tick
forx=0to4:ci=y*5+x
vi=te(ck,ci)and128:vt=te(ck,ci)and31:rem determine visited flag/location type
r0$="":r1$="":ifvt<>0thenr0$=rn$:r1$=rf$:rem set rvs video or not
ifvt<>0thenc$=gd$:ifvi<>0thenc$=gl$:rem determine color of building
ifvt=0thenc$=gd$:ifvi<>0thenc$=lg$:rem determine color of non-building
ifvi=0andck<>hkthenc$=c$+uk$:goto@l_main_non_building:rem uncharted territory
ifvt=0thenc$=c$+te$:goto@l_main_non_building:rem terrain
ifvt=1thenc$=c$+r0$+"c"+r1$:goto@l_main_non_building:rem citadel
ifvt=2thenc$=c$+r0$+"s"+r1$:goto@l_main_non_building:rem sanctuary
ifvt=4thenc$=c$+r0$+"b"+r1$:goto@l_main_non_building:rem bazaar
ifvt=8thenc$=c$+r0$+"t"+r1$:goto@l_main_non_building:rem tomb
ifvt=16thenc$=c$+r0$+"r"+r1$:rem ruin
@l_main_non_building
ifck=dd(0)andx+1=dd(1)andy+1=dd(2)thenc$=rd$+dr$:rem dragon
ifx+1=pxandy+1=pythenc$=yw$+r0$+pw$+r1$+tc$:rem warrior
mp$(3-y)=mp$(3-y)+c$
nextx
mp$(3-y)=mp$(3-y)+"  "
ony+1goto@l_main_legend_4,@l_main_legend_3,@l_main_legend_2,@l_main_legend_1
@l_main_legend_1
mp$(3-y)=mp$(3-y)+h4$+"map legend"
goto@l_main_loop_next
@l_main_legend_2
mp$(3-y)=mp$(3-y)+tc$+rn$+"b"+rf$+tc$+":bazaar    "
mp$(3-y)=mp$(3-y)+tc$+rn$+"c"+rf$+tc$+":citadel "
mp$(3-y)=mp$(3-y)+tc$+rn$+"r"+rf$+tc$+":ruin"
goto@l_main_loop_next
@l_main_legend_3
mp$(3-y)=mp$(3-y)+tc$+rn$+"s"+rf$+tc$+":sanctuary "
mp$(3-y)=mp$(3-y)+tc$+rn$+"t"+rf$+tc$+":tomb    "
mp$(3-y)=mp$(3-y)+yw$+pw$+tc$+":army"
goto@l_main_loop_next
@l_main_legend_4
mp$(3-y)=mp$(3-y)+lg$+te$+tc$+":terrain   "
mp$(3-y)=mp$(3-y)+gd$+uk$+tc$+":unknown "+rd$+dr$+tc$+":dragon"
@l_main_loop_next
nexty
dl=2:gosub@p_sleep:rem delay needed when blitzed!
printcs$chr$(kc(ck))rn$sp$rf$;
c1$=rn$+chr$(kt(ck))+kn$(ck)+rf$+tc$+" ["+mid$(str$(px),2)+","
c1$=c1$+mid$(str$(py),2)+"] "+h4$+lo$+tc$:a=40-len(c1$)
c2$=tc$+"turn:"+mid$(str$(tu%+1),2):a=a-len(c2$)+7
c1$=c1$+left$(sp$,a)+c2$
printc1$;
printchr$(kc(ck))rn$sp$rf$;
fori=0to3:printmp$(i):nexti
print
print"     "rn$h1$"n"rf$tc$"orth";
kt$="            ":rem empty key name placeholder
ifky(1)=1thenki%=0:gosub@p_key_name:kt$=left$(kt$+"      ",13)
print"       "kt$;
printtc$"army:";
gosub@p_is_army_low:iflw%thenprintrn$;
printrl$mid$(str$(wr),2)tc$
iflw%thenprintrf$;
printrn$h1$"w"rf$tc$"est";
c$="       ":iflo$<>"terrain"thenc$=" en"+h1$+rn$+"t"+rf$+tc$+"er "
printc$rn$h1$"e"rf$tc$"ast";
kt$="            ":rem empty key name placeholder
ifky(2)=1thenki%=1:gosub@p_key_name:kt$=left$(kt$+"     ",13)
print"  "kt$;
printtc$"food:";
gosub@p_is_food_low:iflf%thenprintrn$;
printlg$mid$(str$(int(fd)),2)tc$
iflf%thenprintrf$;
print"     "rn$h1$"s"rf$tc$"outh";
kt$="            ":rem empty key name placeholder
ifky(3)=1thenki%=2:gosub@p_key_name:kt$=left$(kt$+"       ",13)
print"       "kt$;
printtc$"gold:";
gosub@p_is_gold_low:iflg%thenprintrn$;
printyw$mid$(str$(gd),2)tc$
iflg%thenprintrf$;
gosub@p_show_inventory
return
rem === action prompt ===
@p_action_prompt
na%=0:rem reset no action flag
print:nk=ck+1:ifnk>3thennk=0:rem compute index of next kingdom
ifck<>hkthengoto@l_action_frontier_check
gosub@p_key_total:rem compute total keys acquired so far
ifpy>3andtk=3thenprinth1$"north from here to storm the gate":goto@l_action_choice
@l_action_frontier_check
ifpx>4andky(ck)=1thenprinth1$"go east from here to enter "kn$(nk)tc$
@l_action_choice
a$="":printh4$"choose: "tc$;
aa$=ba$+"3nswe"
iflo$<>"terrain"thenaa$=aa$+"t"
ifpg=1thenaa$=aa$+"p"
ifwz=1thenaa$=aa$+"z"
gosub@p_select_char:print:ax$=a$
tr=0:rem default gold treasure percentage to zero
gosub@p_starvation_check:rem starvation check
ifgm%<>0thengoto@l_action_return
ifax$<>"t"thenox=px:oy=py:goto@l_action_movement
iflo$="tomb"orlo$="ruin"thengosub@p_tomb_ruin:goto@l_action_completed
iflo$="bazaar"thengosub@p_bazaar:goto@l_action_return
iflo$="sanctuary"orlo$="citadel"thengosub@p_sanctuary_citadel:goto@l_action_completed
@l_action_movement
ifax$="n"orax$="3"thendi$="north":gosub@p_move_north:goto@l_action_completed
ifax$="s"thendi$="south":gosub@p_move_south:goto@l_action_completed
ifax$="e"thendi$="east":gosub@p_move_east:goto@l_action_completed
ifax$="w"thendi$="west":gosub@p_move_west:goto@l_action_completed
ifax$="p"andpg=1thengosub@p_pegasus_use:goto@l_action_completed
ifax$="z"andwz=1thengosub@p_wizard_use:goto@l_action_completed
ifax$=ba$thengosub@p_leave_game:goto@l_action_return
@l_action_completed
ifna%thengoto@l_action_return
tu%=tu%+1:rem increment turn counter
gosub@p_eat_food:rem consume food
@l_action_return
return
rem === move army back to previous location ===
@p_move_back
px=ox:py=oy
return
rem === move north ===
@p_move_north
ifpy<4thengosub@p_pre_move:py=py+1:gosub@p_movement:return
gosub@p_map_edge:return
rem === move south ===
@p_move_south
ifpy>1thengosub@p_pre_move:py=py-1:gosub@p_movement:return
gosub@p_map_edge:return
rem === move east ===
@p_move_east
ifpx<5thengosub@p_pre_move:px=px+1:gosub@p_movement:return
gosub@p_map_edge:return
rem === move west ===
@p_move_west
ifpx>1thengosub@p_pre_move:px=px-1:gosub@p_movement:return
rem === at map edges ===
@p_map_edge
ifpy=4anddi$="north"thengosub@p_pre_move:gosub@p_fortress_travel:return
ifpx=5anddi$="east"thengosub@p_pre_move:gosub@p_frontier_travel:return
printyw$"at map's edge"tc$
na%=-1:rem no action accepted
return
rem === pre-movement processing ===
@p_pre_move
gosub@p_loc_to_idx:rem compute current location index
te(ck,ci)=te(ck,ci)or128:rem previous position is visited
ifbz(ck)=1thenbz(ck)=0:rem re-open a closed bazaar
return
rem === movement processing ===
@p_movement
ifgm%=3thenreturn:rem game over in progress
printtc$"heading "h3$di$tc$"... ";
gosub@p_sound_footsteps:rem footsteps
@l_new_location
ifdd(0)=ckanddd(1)=pxanddd(2)=pythengoto@l_move_dragon:rem dragon blocks path
gosub@p_location:rem derive location info
te(ck,ci)=te(ck,ci)or128:rem set location to visited
gosub@p_key_here_check
ifkpandlo$="terrain"thengosub@p_brigands_encounter:return:rem brigands+key here
gosub@p_skip_event:ifsk%thengosub@p_safe:return:rem skip events
lo=1:hi=22:gosub@p_random_range:r=val(mid$(ew$,r,1))
onrgosub@p_safe,@p_lost,@p_plague,@p_brigands_encounter,@p_dragon_encounter,@p_wizard_curse
return
@l_move_dragon
ifsw=0thengoto@l_move_dragon_forbids
printrd$"dragon ";:gosub@p_sound_dragon_attack
gosub@p_dragon_vanq:return:rem dragon vanquished
@l_move_dragon_forbids
printrd$"dragon"tc$" forbids entry!"tc$
gosub@p_move_back:rem move army back to previous location
na%=-1:rem no action accepted
return
rem === safe ===
@p_safe
printlg$"safe."tc$;
return
rem === brigands ===
@p_brigands_encounter
printcs$rd$"brigands!"tc$:print
a=int(wr/2):ifa<1thena=1
lo=wr:hi=lo+a:gosub@p_random_range:bw=int(r)
pw=wr
rem === combat ===
@p_brigands_battle
b0$=mid$(str$(bw),2):w0$=mid$(str$(pw),2)
gosub@p_sound_battle_charge:rem battle charge sound
rem === battle! ===
@l_brigands_combat_loop
gosub@p_dice_pct:rem percentile roll
co%=2+(r>(pw/(pw+bw))*100)
onco%goto@l_player_lost_round,@l_player_won_round
@l_player_lost_round
bc%=10:gosub@p_border_flash
pw=pw-1:rem lose a warrior
sc%=sc%-1:rem adjust score
goto@l_brigands_prompt
@l_player_won_round
bc%=14:gosub@p_border_flash
bk=int(bw/2):bw=bw-bk+(bk<1):rem reduce enemy army by 1/2
sc%=sc%+bk:rem adjust score
@l_brigands_prompt
printrl$"enemy:"h3$mid$(str$(bw),2)tc$"/"b0$;
printbl$" you:"h3$mid$(str$(pw),2)tc$"/"w0$" ";
onco%gosub@p_sound_player_loss,@p_sound_enemy_loss:rem player or enemy loss sound
ifpw<=0orbw<=0thengoto@l_brigands_combat_over
printtc$rn$h1$"f"rf$tc$"ight";
ifpw<2thenprinth3$"!!! "tc$;
ifpw>1thenprint" "rn$h1$"r"rf$tc$"etreat ";
aa$="f":ifpw>1thenaa$=aa$+"r"
gosub@p_select_char
ifa$="r"thengoto@l_brigands_retreat
goto@l_brigands_combat_loop:rem loop
rem === retreat from combat ===
@l_brigands_retreat
print:printyw$"retreat! "tc$:print
fl=1:wr=pw-fl:rem suffer one casualty
gosub@p_adjust_gold_carried:rem adjust gold carried
printh1$mid$(str$(fl),2)tc$" ";:wr%=fl:gosub@p_warriors_print
print" perished in the fallback to"
print"the previous location"
gosub@p_music_funeral_march:rem retreat music
gosub@p_army_eliminated_check
ifwr>0thengosub@p_move_back:rem move army back to previous location
iffb=1thenfb=0:gosub@p_rnd_key_order:rem re-randomize key code
goto@l_brigands_return
rem === combat over ===
@l_brigands_combat_over
lw=wr-pw:wr=pw:gosub@p_adjust_gold_carried:rem adjust gold carried
print:print
ifwr>0thenprintlg$"victory!"tc$:gosub@p_sound_battle_over
iflw<1thengoto@l_brigands_vanquished
print:printh1$mid$(str$(lw),2)tc$" ";:wr%=lw:gosub@p_warriors_print
print" perished in the battle"
gosub@p_army_eliminated_check:ifwr=0thengoto@l_brigands_return
@l_brigands_vanquished
iffb=1thengoto@l_brigands_any_key
gosub@p_dice_pct:rem percentile roll
tr=50:gl%=5:gh%=20:gosub@p_gold:rem treasure check
goto@l_brigands_return
@l_brigands_any_key
gosub@p_any_key:rem hit return to continue
@l_brigands_return
return
rem === dragon ===
@p_dragon_encounter
iflo$="terrain"andpx<5andpy<4thengoto@l_dragon_encounter
gosub@p_safe:return:rem dragon should not appear in this territory
@l_dragon_encounter
printrd$"dragon ";
gosub@p_sound_dragon_attack:rem dragon encounter sound
ifsw=1thengosub@p_dragon_vanq:return
dd(0)=ck:dd(1)=px:dd(2)=py:rem place dragon at current location
@dragon_blockade
ifgd=0orwr<2thenprint"blockades!"tc$:goto@l_dragon_retreat
@dragon_ambush
print"ambushes!"tc$:gosub@p_robbed:rem robbed
dg=dg+sg:dw=dw+sl:rem update dragon's stolen hoard
!- gosub@p_loc_to_idx:te(ck,ci)=te(ck,ci)and127:rem clear visited bit
@l_dragon_retreat
print"army falls back to previous location"
gosub@p_move_back:rem move army back to previous location
return
@p_dragon_vanq
printlg$"vanquished!"tc$
gosub@p_sound_vanquished:rem vanquished sound
dd(0)=-1:dd(1)=-1:dd(2)=-1:rem reset dragon's position
sw=0:rem relinquish the sword
ifdg+dw=0thengoto@l_dragon_vanq_return
print"recovered ";
ifdg>0thengd=gd+dg:printh1$mid$(str$(dg),2)tc$" gold ";
ifdg>0anddw>0thenprint"and ";
ifdw>0thenwr=wr+dw:printh1$mid$(str$(dw),2)tc$" ";
ifdw>0thenwr%=dw:gosub@p_warriors_print:print
dg=0:dw=0:rem clear out dragon's stolen hoard
!- gosub@p_any_key:rem hit return to continue
@l_dragon_vanq_return
return
rem === plague ===
@p_plague
printvi$"plague!"tc$
ifhl=1thengosub@p_healer:return
gosub@p_music_funeral_march:rem plague sound
ls=2:ifls>wrthenls=wr
wr=wr-ls:gosub@p_adjust_gold_carried:rem adjust gold carried
printh1$mid$(str$(ls),2)tc$" ";:wr%=ls:gosub@p_warriors_print:print" perished"
gosub@p_army_eliminated_check
return
rem === healer rescues ===
@p_healer
printdg$"healer! "tc$;
nw=2:wr=wr+nw
printh1$mid$(str$(nw),2)tc$" new ";:wr%=nw:gosub@p_warriors_print
print" join the ranks"
!- gosub@p_any_key:rem hit return to continue
return
rem === lost ===
@p_lost
printvi$"lost! "tc$;:print
ifsu=1thengosub@p_scout_helps:return
gosub@p_sound_denied:rem sound denied
fc=2:iffc>fdthenfc=fd
iffc>0thenprinth1$mid$(str$(fc),2)tc$" food consumed while going nowhere!"
fd=fd-fc
gosub@p_move_back:rem move army back to previous location
!- gosub@p_any_key:rem hit return to continue
return
rem === scout helps ===
@p_scout_helps
printdg$"scout! "tc$;
nf=2:fd=fd+nf
printh1$mid$(str$(nf),2)tc$" food scavenged"
!- gosub@p_any_key:rem hit return to continue
return
rem === wizard's curse ===
@p_wizard_curse
ifgd=0orwr<2thengosub@p_safe:return
printvi$"cursed!"tc$
ifwz=1thengosub@p_wizard_saves:return
gosub@p_sound_denied:rem denied sound
gosub@p_robbed:rem robbed
return
@p_wizard_saves
gosub@p_sound_vanquished:rem vanquished sound
print"thy wizard disrupts the curse!"
!- gosub@p_any_key:rem hit return to continue
return
rem === key found ===
@p_key_found
ifky(1)=0theni=1:c$=og$+"brass":goto@l_key_found_return
ifky(2)=0theni=2:c$=cy$+"silver":goto@l_key_found_return
ifky(3)=0theni=3:c$=yw$+"gold"
@l_key_found_return
ky(i)=1:rem set key obtained flag
ki(ck)=-1:rem remove key from key locations list
sc%=sc%+100:rem adjust score
print:printtc$"*** "c$tc$" key found! ***"
gosub@p_sound_beep:rem item found sound
return
rem === dragonsword found ===
@p_sword_found
sw=1:c$=og$+"sword"
print:printtc$"*** "c$tc$" found! ***"
gosub@p_sound_beep:rem item found sound
return
rem === pegasus found ===
@p_pegasus_found
pg=1:c$=wh$+"pegasus"
print:printtc$"*** "c$tc$" found! ***"
gosub@p_sound_pegasus:rem pegasus found sound
return
rem === wizard found ===
@p_wizard_found
wz=1:c$=gy$+"wizard"
print:printtc$"*** "c$tc$" found! ***"
gosub@p_sound_beep:rem item found sound
return
rem === use pegasus ===
@p_pegasus_use
gosub@p_sound_pegasus
aa$="":c$="":fori=0to3:ifi>0thenc$=c$+" "
a=(i=0):ifi>0thena=aor(ky(i-1)<>0)
ifathena$=left$(kn$(i),1):aa$=aa$+a$
ifathenc$=c$+rn$+h1$+a$+rf$+tc$+right$(kn$(i),len(kn$(i))-1)
nexti:rem determine which kingdoms allowed for passage
printc$
printh3$"fly to which kingdom?"tc$" ("rn$h1$ba$rf$tc$" to exit) ";
aa$=ba$+aa$:gosub@p_select_char
ifa$=ba$thenna%=-1:return
fori=2tolen(aa$):ifmid$(aa$,i,1)=a$thena=i-2
nexti
bl%(0)=0:bl%(1)=3:bl%(2)=7:bl%(3)=10:bl%(4)=13:rem indices of buildings
bl%(5)=17:aa$="":c$=""
fori=0to5:ifi>0thenc$=c$+" "
vt=te(a,bl%(i))and31
ifvt=0andi<>5thena$="entry"
ifvt=1thena$="citadel"
ifvt=2thena$="sanctuary"
ifvt=4thena$="bazaar"
ifvt=8thena$="tomb"
ifvt=16thena$="ruin"
ifi=5thena$="gate"
b$=left$(a$,1):aa$=aa$+b$:c$=c$+rn$+h1$+b$+rf$+tc$+right$(a$,len(a$)-1)
nexti:rem determine the locations within the selected kingdom
print:printc$
printh3$"and to which location?"tc$" ("rn$h1$ba$rf$tc$" to exit) ";
aa$=ba$+aa$:gosub@p_select_char
ifa$=ba$thenna%=-1:return
fori=2tolen(aa$):ifmid$(aa$,i,1)=a$thenb=bl%(i-2)
nexti
py=int(b/5):px=b-5*py:px=px+1:py=py+1:rem set location
pg=0:rem reset pegasus found flag
ifa<>ckthenck=a:gosub@p_frontier_enter:rem fly to kingdom/location
return
rem === use wizard ===
@p_wizard_use
printtc$"the wizard incants and then vanishes!"
gosub@p_awarded
wz=0:rem relinquish the wizard
return
rem === bazaar ===
@p_bazaar
ifbz(ck)=1thengoto@l_bazaar_closed
bz(4)=0:rem bazaar entry flag
cv=0:rem clear citadel visited flag
hg%=75:rem initial haggle percentage
hc%=0:rem haggle count
fc=1:rem food cost
lo=5:hi=8:gosub@p_random_range:wc=int(r):rem warrior cost
lo=17:hi=9:gosub@p_random_range:bc=int(r):rem beast cost
lo=17:hi=9:gosub@p_random_range:sc=int(r):rem scout cost
lo=17:hi=9:gosub@p_random_range:hc=int(r):rem healer cost
@l_bazaar_main
printcs$og$"bazaar"tc$;
print"   gold:"yw$mid$(str$(gd),2)tc$;
print" army:"rl$mid$(str$(wr),2)tc$;
print" food:"lg$mid$(str$(fd),2)tc$:print
ifbz(4)=0thengosub@p_music_bazaar:bz(4)=1:rem bazaar music
ic%=0:aa$="wf"
mw=int(gd/wc):mf=int(gd/fc)
ifmw>0thenc$=rn$+h1$+"w"+rf$+tc$+"arrior  "+h3$
ifmw<1thenc$=gd$+"warrior  "
c$=c$+left$(mid$(str$(wc),2),2)
ifmw>0thenc$=c$+tc$+"g (max "+cy$+mid$(str$(mw),2)+tc$+")"
