91 FORI=2TOLEN(AA$):IFMID$(AA$,I,1)=A$THENB=BL%(I-2)792 NEXTI793 PY=INT(B/5):PX=B-5*PY:PX=PX+1:PY=PY+1:REM SET LOCATION794 PG=0:REM RESET PEGASUS FOUND FLAG795 IFA<>CKTHENCK=A:GOSUB924:REM FLY TO KINGDOM/LOCATION796 RETURN797 REM === USE WIZARD ===798 PRINTTC$"THE WIZARD INCANTS AND THEN VANISHES!"799 GOSUB458800 WZ=0:REM RELINQUISH THE WIZARD801 RETURN802 REM === BAZAAR ===803 IFBZ(CK)=1THENGOTO853804 BZ(4)=0:REM BAZAAR ENTRY FLAG805 CV=0:REM CLEAR CITADEL VISITED FLAG806 HG%=75:REM INITIAL HAGGLE PERCENTAGE807 FC=1:REM FOOD COST808 LO=5:HI=8:GOSUB317:WC=INT(R):REM WARRIOR COST809 LO=17:HI=9:GOSUB317:BC=INT(R):REM BEAST COST810 LO=17:HI=9:GOSUB317:SC=INT(R):REM SCOUT COST811 LO=17:HI=9:GOSUB317:HC=INT(R):REM HEALER COST812 PRINTCS$OG$"BAZAAR"TC$;813 PRINT"   GOLD:"YW$MID$(STR$(GD),2)TC$;814 PRINT" ARMY:"RL$MID$(STR$(WR),2)TC$;815 PRINT" FOOD:"LG$MID$(STR$(FD),2)TC$:PRINT816 IFBZ(4)=0THENGOSUB94:BZ(4)=1:REM BAZAAR MUSIC817 IC%=0:AA$="WF"818 MW=INT(GD/WC):MF=INT(GD/FC)819 IFMW>0THENC$=RN$+H1$+"W"+RF$+TC$+"ARRIOR  "+H3$820 IFMW<1THENC$=GD$+"WARRIOR  "821 C$=C$+LEFT$(MID$(STR$(WC),2),2)822 IFMW>0THENC$=C$+TC$+"G (MAX "+CY$+MID$(STR$(MW),2)+TC$+")"823 IFMW<1THENC$=C$+"G"824 IC%=IC%OR1:PRINTC$825 IFMF>0THENC$=RN$+H1$+"F"+RF$+TC$+"OOD     "+H3$826 IFMF<1THENC$=GD$+"FOOD     "827 C$=C$+LEFT$(MID$(STR$(FC),2),2)828 IFMF>0THENC$=C$+TC$+"G (MAX "+CY$+MID$(STR$(MF),2)+TC$+")"829 IFMF<1THENC$=C$+"G"830 IC%=IC%OR2:PRINTC$831 C$=RN$+H1$+"B"+RF$+TC$+"EAST    "832 C$=C$+H3$+MID$(STR$(BC),2)+TC$+"G"833 IFBS=0ANDGD>=BCTHENIC%=IC%OR4:PRINTC$:AA$=AA$+"B"834 C$=RN$+H1$+"S"+RF$+TC$+"COUT    "835 C$=C$+H3$+MID$(STR$(SC),2)+TC$+"G"836 IFSU=0ANDGD>=SCTHENIC%=IC%OR8:PRINTC$:AA$=AA$+"S"837 C$=RN$+H1$+"H"+TC$+RF$+"EALER   "838 C$=C$+H3$+MID$(STR$(HC),2)+TC$+"G"839 IFHL=0ANDGD>=HCTHENIC%=IC%OR16:PRINTC$:AA$=AA$+"H"840 PRINT841 IFIC%>0THENPRINT"H"RN$H1$"A"RF$TC$"GGLE ";:AA$=AA$+"A"842 PRINT"E"H1$RN$"X"RF$TC$"IT":AA$=AA$+"X"843 PRINT:C$="":PRINT