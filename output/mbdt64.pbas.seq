:BU(1)=4:BU(2)=8:REM INITIAL ORDERING OF SWAPPABLE BUILDINGS1059 FORI=0TO19:READ A:FORK=0TO3:TE(K,I)=A:IFK>0ANDI=0THENTE(K,I)=01060 NEXTK:NEXTI:REM INIT ALL KINGDOMS1061 REM === INITIALIZE GAME STATE ===1062 NI=1:GOSUB15:REM INIT SOUND1063 KY(0)=1:FORI=1TO3:KY(I)=0:NEXTI:REM RESET KEY FLAGS1064 FORI=0TO2:DD(I)=-1:NEXTI:REM RESET DRAGON DATA1065 SU=0:BS=0:HL=0:PG=0:SW=0:WZ=0:TU%=0:SC%=0:VC%=01066 HK=0:CK=0:TK=0:PX=1:PY=1:OX=PX:OY=PY1067 CV=0:DG=0:DW=0:FB=0:GM%=0:KO$=""1068 REM === TITLE SCREEN ===1069 TL$=TT$:L%=LEN(TL$):IF(L%AND1)=0THENL%=L%+1:TL$=TL$+" "1070 T%=(LEN(SP$)-L%)/21071 PRINTCS$;1072 PRINTLEFT$(SP$,T%+(L%-5)/2);:FORI=1TO5:A=IAND11073 IFA=0THENPRINT" ";1074 IFA=1THENPRINTOG$RN$" "RF$;1075 NEXTI:PRINT1076 PRINTLEFT$(SP$,T%+(L%-5)/2)OG$RN$LEFT$(SP$,5)RF$1077 FORI=1TO2:PRINTLEFT$(SP$,T%+(L%-3)/2)OG$RN$LEFT$(SP$,3)RF$:NEXTI1078 PRINTLEFT$(SP$,T%)YW$RN$TL$RF$1079 PRINT:PRINTTC$1080 PRINTTAB(5)"THE SCEPTER HAS BEEN STOLEN BY"1081 PRINTTAB(5)"THE EVIL TYRANT KING!"1082 PRINT:PRINTTAB(5)"FIND THE THREE MAGIC KEYS AND"1083 PRINTTAB(5)"STORM THE DREAD "H1$TT$TC$"!"1084 GOSUB36:REM INTRO MUSIC1085 PRINT:PRINTTAB(14)H4$"PLAY LEVEL:":PRINT1086 AA$="":C$="":FORI=0TO3:A$=LEFT$(DF$(I),1):AA$=AA$+A$1087 C$=RN$+H1$+A$+RF$+TC$+RIGHT$(DF$(I),LEN(DF$(I))-1)1088 PRINTTAB(15)C$:NEXTI1089 PRINT:PRINTTAB(14)H4$"CHOOSE: "TC$;1090 GOSUB3421091 FORI=1TOLEN(AA$):IFMID$(AA$,I,1)=A$THENDF=I-11092 NEXTI1093 PRINT:PRINT:PRINTGY$"PREPARING NEW GAME...";1094 GOSUB1032:REM RANDOMIZE GATE LOCK'S KEY CODE1095 REM === GAME LEVEL SETTINGS ===1096 WR=10:FD=25:GD=30:REM COMMON GAME SETTINGS1097 IFDF=0THENLO=17:HI=32:GOSUB317:EW=INT(R)1098 IFDF=1THENLO=33:HI=64:GOSUB317:EW=INT(R)1099 IFDF=2THENLO=17:HI=64:GOSUB317:EW=INT(R)1100 IFDF=3THENKO$="GSB":EW=16:PY=4:OY=PY:SU=1:BS=1:HL=1:SW=1:PG=1:WZ=11101 IFDF=3THENFORI=1TO3:KY(I)=1:NEXTI:REM GRANT ALL KEYS1102 REM === SHUFFLE CERTAIN BUILDINGS WITHIN EACH KINGDOM ===1103 FORK=0TO3:FORI=0TO21104 LO=0:HI=2:GOSUB317:R=INT(R)1105 T=BU(I):BU(I)=BU(R):BU(R)=T:NEXTI:REM SHUFFLE1106 L=0:FORI=0TO19:A=TE(K,I):IF(AAND14)>0THENTE(K,I)=BU(L):L=L+11107 NEXTI:NEXTK1108 REM === PLACE KEYS ===1109 FORK=1TO31110 J=0:FORI=0TO19:IF0=(TE(K,I)AND7)THENKK(J)=I:J=J+11111 NEXTI:REM ISOLATE TOMB,RUINS,TERRAIN FROM LOCATION TYPES1112 LO=0:HI=17:FORI=LOTOHI:GOSUB317:R=INT(R)1113 T=KK(I):KK(I)=KK(R):KK(R)=T:NEXTI1114 KI(K)=KK(0):REM SELECT THE TOP ELEMENT1115 NEXTK1116 REM === CLEAR MAPS ===1117 FORK=0TO3:FORI=0TO191118 TE(K,I)=TE(K,I)AND127:REM CLEAR VISITED BIT1119 NEXTI:NEXTK1120 REM === MAIN GAME LOOP ===1121 IFGM%=3THENGOSUB10091122 IFGM%>0THENONGM%GOTO1062,11281123 GOSUB468:REM MAIN SCREEN1124 GOSUB540:REM ACTION PROMPT1125 POKES+4,0:REM CLOSE GATE V11126 GOTO11211127 REM === END ===1128 END1129 REM === DATA ===1130 DATA1,0,0,2,0,0,0,8,0,0,4,0,0,16,0,0,0,0,0,0