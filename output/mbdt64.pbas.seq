GAINED "H1$MID$(STR$(NW),2)" "TC$;:WR%=NW:GOSUB362:PRINT898 IFNF>0THENPRINT"GAINED "H1$MID$(STR$(NF),2)TC$" FOOD"899 IFNG>0THENPRINT"GAINED "H1$MID$(STR$(NG),2)TC$" GOLD"900 IFAD=0THENPRINTH1$"SUFFICIENTLY PROVISIONED"TC$901 RETURN902 REM === TOMB/RUIN ===903 GOSUB327:VI=TE(CK,CI)AND128:VT=TE(CK,CI)AND31904 PRINTVI$;905 IFLO$="TOMB"THENPRINT"ENTERING";:NU$="EMPTY":TR=30:GL%=13:GH%=20:BR=62.5906 IFLO$="RUIN"THENPRINT"EXPLORING";:NU$="NOTHING":TR=25:GL%=13:GH%=20:BR=62.5907 PRINT" THE "LO$"..."TC$908 GOSUB271:REM CREAK OPEN SOUND909 CV=0:REM CLEAR CITADEL VISITED FLAG910 GOSUB320:REM PERCENTILE ROLL FOR BRIGANDS OR TREASURE911 IFR<=TRTHENGOSUB422:GOTO914:REM TREASURE912 IFR<=BRTHENGOSUB616:RETURN:REM BRIGANDS913 GOSUB283:PRINTGY$NU$TC$914 RETURN915 REM === FRONTIER ===916 PRINTGY$"FRONTIER: "TC$;917 IFCK=HKTHENGOTO923918 NK=0:REM UNSET NEEDS KEY FLAG919 IFCK=1ANDKY(1)=0THENNK=1:KI%=0:GOSUB357:REM SET NEEDS KEY FLAG (BRASS)920 IFCK=2ANDKY(2)=0THENNK=1:KI%=1:GOSUB357:REM SET NEEDS KEY FLAG (SILVER)921 IFCK=3ANDKY(3)=0THENNK=1:KI%=2:GOSUB357:REM SET NEEDS KEY FLAG (GOLD)922 IFNK=1THENGOTO929923 PX=1:CK=CK+1:IFCK>3THENCK=0924 OX=PX:OY=PY925 PRINTTC$"ENTERING "KN$(CK)"..."926 BC%=13:GOSUB12927 GOSUB210928 GOTO599929 KI%=CK-1:GOSUB357:PRINTRL$"MISSING "KT$TC$"!"930 GOSUB121:REM DENIED SOUND931 RETURN932 REM === THE FORTRESS! ===933 GOSUB354:IFTK=3THENGOTO938934 A=3-TK935 PRINTH1$MID$(STR$(A),2)TC$" KEY";:IFA<>1THENPRINT"S";936 PRINT" STILL NEEDED TO UNLOCK THE"937 GOTO940938 IFCK=HKTHENGOTO945939 PRINTTC$"RETURN TO "H1$KN$(HK)TC$" TO STORM THE"940 PRINTH1$TT$"!!!"TC$941 CV=0:REM CLEAR CITADEL VISITED FLAG942 NA%=-1943 RETURN944 REM === DISPLAY FOREBODING BANNER ===945 PRINTCS$RD$RN$SP$RF$;946 PRINTGY$TT$947 PRINTRD$RN$SP$RF$;948 PRINTTC$949 PRINT:PRINTVI$"RIDDLE OF THE KEYS!"TC$:PRINT950 GOSUB59:REM BATTLE MUSIC951 PRINT"ENTER ORDER ("BR$"B"TC$"/"GL$"S"TC$"/"YW$"G"TC$")...":PRINT952 FS$(0)="":FORRI=1TO3:PRINTTC$"KEY #"H3$MID$(STR$(RI),2)": "TC$;953 AA$="":FORRJ=1TO3:FS$(1)=MID$(KO$,RJ,1):FI%(0)=LEN(FS$(0)):FI%(1)=0954 FORRK=1TOFI%(0)955 IFMID$(FS$(0),RK,1)=FS$(1)THENFI%(1)=1:RK=FI%(0)956 NEXTRK957 IFFI%(1)=0THENAA$=AA$+FS$(1)958 NEXTRJ959 IFRI<3THENGOSUB342960 IFRI=3THENA$=AA$:GOSUB339961 FS$(0)=FS$(0)+A$962 NEXTRI963 IFFS$(0)=KO$THENGOTO969964 REM === WRONG ANSWER ===965 PRINT:PRINTRD$"WRONG!"TC$" ARMY FORCED BACK";966 GOSUB121:REM DENIED967 RETURN968 REM === UNLOCKED THE GATE ===969 PRINT:PRINTLG$"UNLOCKED!!!"TC$970 PRINT:PRINTH1$MID$(STR$(EW),2)TC$" BRIGANDS DEFEND "TT$971 PRINTH1$MID$(STR$(WR),2)TC$" ";:WR%=WR:GOSUB362972 PRINT" POISED FOR BATTLE"973 PRINT:PRINT"ATTACK? "RN$H1$"Y"RF$TC$"ES OR "RN$H1$"N"RF$TC$"O ";974 AA$="YN":GOSUB342975 IFA$="N"THENGOSUB982:RETURN:REM FLEE976 PRINTCS$"THE FINAL BATTLE!":PRINT977 FB=1:REM SET FINAL BATTLE FLAG TO TRUE978 FW=WR:PW=WR:BW=EW:GOSUB621:REM BATTLE979 IFWR>0ANDBW<1THENVC%=1:GM%=3:GOSUB992:REM VICTORY980 RETURN981 REM === FLEE ATTEMPT ===982 PRINT:PRINT"FLEEING... ";:DL=1:GOSUB8983 GOSUB320:REM DICE PERCENTAGE984 IFR<=50THENGOTO989985 PRINTLG$"ESCAPED"TC$986 GOSUB1032:REM RE-RANDOMIZE KEY CODE987 PRINT"THE GATE MAGICALLY RE-LOCKS";988 GOTO990989 PRINTRD$"CAUGHT!"TC$:DL=1:GOSUB8:GOTO976990 RETURN991 REM === VICTORY SCREEN ===992 PRINTCS$YW$;993 PRINTRN$SP$RF$;994 PRINTRN$"            *** VICTORY! ***            "RF$;995 PRINTRN$"                                        "RF$;996 PRINTRN$" THOU HAST TAKEN OVER THE FORTRESS...   "RF$;997 PRINTRN$"                                        "RF$;998 PRINTRN$" AND NOW THE SCEPTER IS FINALLY THINE!  "RF$;999 PRINTRN$SP$RF$1000 GOSUB36:REM VICTORY MUSIC1001 GOSUB323:REM HIT RETURN TO CONTINUE1002 RETURN1003 REM === LEAVE GAME ===1004 PRINT"EXIT THE GAME NOW? "H1$RN$"Y"RF$TC$"ES OR "H1$RN$"N"RF$TC$"O ";1005 AA$="YN":GOSUB3421006 IFA$="Y"THENGM%=3:GOSUB10091007 RETURN1008 REM === GAME OVER ===1009 PRINTCS$;1010 PRINTCY$"GAME OVER"TC$;1011 IF