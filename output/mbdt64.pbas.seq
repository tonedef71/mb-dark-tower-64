PEAR IN THIS TERRITORY674 PRINTRD$"DRAGON ";675 GOSUB177:REM DRAGON ENCOUNTER SOUND676 IFSW=1THENGOSUB684:RETURN677 DD(0)=CK:DD(1)=PX:DD(2)=PY:REM PLACE DRAGON AT CURRENT LOCATION678 IFGD=0ORWR<2THENPRINT"BLOCKADES!"TC$:GOTO681679 PRINT"AMBUSHES!"TC$:GOSUB447:REM ROBBED680 DG=DG+SG:DW=DW+SL:REM UPDATE DRAGON'S STOLEN HOARD681 PRINT"ARMY FALLS BACK TO PREVIOUS LOCATION"682 GOSUB571:REM MOVE ARMY BACK TO PREVIOUS LOCATION683 RETURN684 PRINTLG$"VANQUISHED!"TC$685 GOSUB188:REM VANQUISHED SOUND686 DD(0)=-1:DD(1)=-1:DD(2)=-1:REM RESET DRAGON'S POSITION687 SW=0:REM RELINQUISH THE SWORD688 IFDG+DW=0THENGOTO696689 PRINT"RECOVERED ";690 IFDG>0THENGD=GD+DG:PRINTH1$MID$(STR$(DG),2)TC$" GOLD ";691 IFDG>0ANDDW>0THENPRINT"AND ";692 IFDW>0THENWR=WR+DW:PRINTH1$MID$(STR$(DW),2)TC$" ";693 IFDW>0THENWR%=DW:GOSUB362:PRINT694 DG=0:DW=0:REM CLEAR OUT DRAGON'S STOLEN HOARD695 GOSUB323:REM HIT RETURN TO CONTINUE696 RETURN697 REM === PLAGUE ===698 PRINTVI$"PLAGUE!"TC$699 IFHL=1THENGOSUB707:RETURN700 GOSUB76:REM PLAGUE SOUND701 LS=2:IFLS>WRTHENLS=WR702 WR=WR-LS:GOSUB416:REM ADJUST GOLD CARRIED703 PRINTH1$MID$(STR$(LS),2)TC$" ";:WR%=LS:GOSUB362:PRINT" PERISHED"704 GOSUB406705 RETURN706 REM === HEALER RESCUES ===707 PRINTDG$"HEALER! "TC$;708 NW=2:WR=WR+NW709 PRINTH1$MID$(STR$(NW),2)TC$" NEW ";:WR%=NW:GOSUB362710 PRINT" JOIN THE RANKS"711 RETURN712 REM === LOST ===713 PRINTVI$"LOST! "TC$;:PRINT714 IFSU=1THENGOSUB722:RETURN715 GOSUB121:REM SOUND DENIED716 FC=2:IFFC>FDTHENFC=FD717 IFFC>0THENPRINTH1$MID$(STR$(FC),2)TC$" FOOD CONSUMED WHILE GOING NOWHERE!"718 FD=FD-FC719 GOSUB571:REM MOVE ARMY BACK TO PREVIOUS LOCATION720 RETURN721 REM === SCOUT HELPS ===722 PRINTDG$"SCOUT! "TC$;723 NF=2:FD=FD+NF724 PRINTH1$MID$(STR$(NF),2)TC$" FOOD SCAVENGED"725 RETURN726 REM === WIZARD'S CURSE ===727 IFGD=0ORWR<2THENGOSUB613:RETURN728 PRINTVI$"CURSED!"TC$729 IFWZ=1THENGOSUB733:RETURN730 GOSUB121:REM DENIED SOUND731 GOSUB447:REM ROBBED732 RETURN733 GOSUB18