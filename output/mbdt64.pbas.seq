DED ===458 LO=17:HI=EW:GOSUB317:WG%=INT(R/4):WR=WR+WG%459 PRINTH1$MID$(STR$(WG%),2)TC$" ";:WR%=WG%:GOSUB362460 MX=WR*6:IFBS=1THENMX=MX+50461 IFGD>=MXTHENGOTO465462 LO=0:HI=(MX-GD)/4:GOSUB317:GG%=INT(R)463 IFGG%>0THENGD=GD+GG%:PRINT" AND "H1$MID$(STR$(GG%),2)TC$" GOLD";464 PRINT" GAINED";465 PRINT466 RETURN467 REM === MAIN DISPLAY ===468 GOSUB354:REM COMPUTE TOTAL KEYS ACQUIRED469 GOSUB330:REM DERIVE LOCATION INFO470 FORY=3TO0STEP-1:MP$(3-Y)=""471 FORX=0TO4:CI=Y*5+X472 VI=TE(CK,CI)AND128:VT=TE(CK,CI)AND31:REM DETERMINE VISITED FLAG/LOCATION TYPE473 R0$="":R1$="":IFVT<>0THENR0$=RN$:R1$=RF$:REM SET RVS VIDEO OR NOT474 IFVT<>0THENC$=GD$:IFVI<>0THENC$=GL$:REM DETERMINE COLOR OF BUILDING475 IFVT=0THENC$=GD$:IFVI<>0THENC$=LG$:REM DETERMINE COLOR OF NON-BUILDING476 IFVI=0ANDCK<>HKTHENC$=C$+UK$:GOTO483:REM UNCHARTED TERRITORY477 IFVT=0THENC$=C$+TE$:GOTO483:REM TERRAIN478 IFVT=1THENC$=C$+R0$+"C"+R1$:GOTO483:REM CITADEL479 IFVT=2THENC$=C$+R0$+"S"+R1$:GOTO483:REM SANCTUARY480 IFVT=4THENC$=C$+R0$+"B"+R1$:GOTO483:REM BAZAAR481 IFVT=8THENC$=C$+R0$+"T"+R1$:GOTO483:REM TOMB482 IFVT=16THENC$=C$+R0$+"R"+R1$:REM RUIN483 IFCK=DD(0)ANDX+1=DD(1)ANDY+1=DD(2)THENC$=RD$+DR$:REM DRAGON484 IFX+1=PXANDY+1=PYTHENC$=YW$+R0$+PW$+R1$+TC$:REM WARRIOR485 MP$(3-Y)=MP$(3-Y)+C$486 NEXTX487 MP$(3-Y)=MP$(3-Y)+"  "488 ONY+1GOTO499,495,491,489489 MP$(3-Y)=MP$(3-Y)+H4$+"MAP LEGEND"490 GOTO501491 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"B"+RF$+TC$+":BAZAAR    "492 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"C"+RF$+TC$+":CITADEL "493 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"R"+RF$+TC$+":RUIN"494 GOTO501495 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"S"+RF$+TC$+":SANCTUARY "496 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"T"+RF$+TC$+":TOMB    "497 MP$(3-Y)=MP$(3-Y)+YW$+PW$+TC$+":ARMY"498 GOTO501499 MP$(3-Y)=MP$(3-Y)+LG$+TE$+TC$+":TERRAIN   "500 MP$(3-Y)=MP$(3-Y)+GD$+UK$+TC$+":UNKNOWN "+RD$+DR$+TC$+":DRAGON"501 NEXTY502 PRINTCS$CHR$(KC(CK))RN$SP$RF$;503 C1$=RN$+CHR$(KT(CK))+KN$(CK)+RF$+TC$+" ["+MID$(STR$(PX),2)+","504 C1$=C1$+MID$(STR$(PY),2)+"