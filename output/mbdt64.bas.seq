3340 rem === a random number between lo and hi ===
3350 r=lo+int(rnd(0)*(1+hi-lo)):rem decimal value between lo and hi
3360 return
3370 rem === percentile roll ===
3380 lo=1:hi=100:gosub3350:rem decimal value between 1 and 100
3390 return
3400 rem === hit return key to continue ===
3410 print:printtc$"hit "h1$rn$"return"rf$tc$" to continue"
3420 aa$=rt$:gosub3600
3430 return
3440 rem === derive current index from current location ===
3450 ci=(py-1)*5+(px-1)
3460 return
3470 rem === current location ===
3480 gosub3450:vi=te(ck,ci)and128:vt=te(ck,ci)and31
3490 ifvt=0thenlo$="terrain"
3500 ifvt=1thenlo$="citadel"
3510 ifvt=2thenlo$="sanctuary"
3520 ifvt=4thenlo$="bazaar"
3530 ifvt=8thenlo$="tomb"
3540 ifvt=16thenlo$="ruin"
3550 return
3560 rem === display key pressed ===
3570 printwh$">"h1$a$wh$"<":dl=0.66:gosub150
3580 return
3590 rem === select a char option ===
3600 poke198,0:rem empty the keyboard buffer
3610 geta$:ifa$=""thengosub250:goto3610
3620 i=0:ln%=len(aa$)
3630 ab$=mid$(aa$,i+1,1):ifab$<>a$andi<ln%theni=i+1:goto3630
3640 ifi<ln%andasc(a$)>32thengosub3570
3650 ifi<ln%thengoto3670
3660 goto3610
3670 return
3680 rem === skip an event ===
3690 sk%=0:ifck=hkandox=1andoy=1thensk%=-1:rem skip events on this turn
3700 return
3710 rem === compute key count total ===
3720 tk=ky(1)+ky(2)+ky(3)
3730 return
3740 rem === format a key name ===
3750 ifki%=0thenkt$=br$+"brass key"
3760 ifki%=1thenkt$=gl$+"silver key"
3770 ifki%=2thenkt$=yw$+"gold key"
3780 return
3790 rem === warrior(s) ===
3800 print"warrior";:ifwr%<>1thenprint"s";
3810 return
3820 rem === print inventory ===
3830 ifsu+bs+hl+sw+pg+wz=0thenc$=gy$+"(none)":goto3920
3840 c$=""
3850 ifpg=1thenc$=c$+h1$+rn$+"p"+rf$+wh$+"egasus "
3860 ifwz=1thenc$=c$+gy$+"wi"+h1$+rn$+"z"+rf$+gy$+"ard "
3870 ifsu=1thenc$=c$+vi$+"scout "
3880 ifbs=1thenc$=c$+bl$+"beast "
3890 ifhl=1thenc$=c$+bd$+"healer "
3900 ifsw=1thenc$=c$+og$+"sword"
3910 print:printc$tc$
3920 return
3930 rem === compute final score ===
3940 iffb=0thengoto3970
3950 a=(ew-17):a=a^2:a=int(a*0.02)+ew
3960 sc%=176+sc%+a-(tu%+fw):rem adjust score
3970 a=2:ifsgn(sc%)<0thena=a-1:rem handle a negative score
3980 printh3$mid$(str$(sc%),a)tc$;
3990 return
4000 rem === is army running low? ===
4010 lw%=(4>wr):rem set lw% flag if less than four warriors remaining
4020 return
4030 rem === is gold running low? ===
4040 lg%=(4>gd):rem set lg% flag if less than four gold remaining
4050 return
4060 rem === consume food ===
4070 fc=int(wr/15):iffc<1thenfc=1
4080 fd=fd-fc:iffd<0thenfd=0
4090 return
4100 rem === is food low? ===
4110 lf%=(4>fd-int(wr/15+.5)):rem set lf% flag if less than four food remaining
4120 return
4130 rem === starvation ===
4140 gosub4110:iflf%thengosub2610:rem low food sound
4150 iffd>0thenreturn
4160 printrd$"starvation! "tc$;
4170 gosub840:rem funeral march sound
4180 ls=1:wr=wr-ls:gosub4340:rem adjust gold carried
4190 print"lost "yw$mid$(str$(ls),2)tc$" ";:wr%=ls:gosub3800:print"!"
4200 gosub4240
4210 ifwr>0thendl=2:gosub150
4220 return
4230 rem === army eliminated check ===
4240 ifwr>=1thengoto4280
4250 wr=0:gm%=3:rem game over in progress
4260 printrd$"defeat!"tc$" thy whole army has perished"
4270 gosub3410:rem hit return to continue
4280 return
4290 rem === undo last turn ===
4300 tu%=tu%-1:rem decrement turn counter
4310 fd=fd+fc:rem restore consumed food
4320 return
4330 rem === adjust amount of gold being carried ===
4340 mx=wr*6:ifbs=1thenmx=mx+50
4350 ifgd>mxthengd=mx
4360 return
4370 rem === gold treasure check ===
4380 g=0:gosub3380:rem percentile roll for gold
4390 ifr>trthengoto4430:rem proceed to check for non-gold treasure
4400 lo=gl%:hi=gh%:gosub3350:g=int(r):rem compute amount of gold found
4410 gd=gd+g:gosub4340
4420 printh1$mid$(str$(g),2)tc$" gold gained"
4430 rem === key treasure check ===
4440 gosub4590
4450 ifkpthengosub7580:goto4580:rem key is present here
4460 rem === non-gold treasure check ===
4470 iftr<1thengoto4580:rem no treasure to be found here
4480 iftr>50thentr=25:rem non-gold treasures should be rare
4490 gosub3380:rem re-roll percentile roll for non-gold treasure
4500 ifr>trthengoto4580
4510 tq%=0:fori=0to2:tr(i)=0:nexti
4520 ifpg=0thentr(tq%)=1:tq%=tq%+1
4530 ifsw=0thentr(tq%)=2:tq%=tq%+1
4540 ifwz=0thentr(tq%)=3:tq%=tq%+1
4550 iftq%<1thengoto4580:rem no treasures available
4560 lo=0:hi=tq%-1:gosub3350
4570 ontr(r)gosub7730,7680,7780
4580 return
4590 rem === is there a key at this location? ===
4600 gosub3720
4610 kp=0:ifck=hkortk=3thenreturn
4620 gosub3450:ifki(ck)=cithenkp=-1
4630 return
4640 rem === robbed ===
4650 sg=0:ifgd>0thensg=int(gd/4):ifsg<1thensg=1
4660 sl=0:ifwr>1thensl=int(wr/4):ifsl<1thensl=1
4670 ifsl+sg<1thengoto4740
