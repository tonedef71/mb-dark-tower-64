=TE(CK,CI)OR128:REM SET LOCATION TO VISITED15550 GOSUB12950:REM ROLL PERCENTILE DICE15560 IFR<=27.27THENGOSUB15660:RETURN:REM SAFE?15570 IFR<=45.45THENGOSUB16650:RETURN:REM LOST15580 IFR<=63.63THENGOSUB16490:RETURN:REM PLAGUE15590 IFR<=81.81THENGOSUB15700:RETURN:REM BRIGANDS15600 IFR<=95.44THENGOSUB16230:RETURN:REM DRAGON!15610 GOSUB16800:RETURN:REM CURSED15620 IFSW=1THENPRINTRD$"DRAGON ";:GOSUB16360:RETURN:REM DRAGON VANQUISHED15630 PRINTRD$"DRAGON"TC$" BLOCKS PATH"TC$;15640 GOSUB15250:REM MOVE ARMY BACK TO PREVIOUS LOCATION15650 RETURN15660 REM === SAFE ===15670 GOSUB14040:IFKP<>0THENGOSUB15700:RETURN:REM BRIGANDS HAVE THE KEY HERE15680 PRINTLG$"SAFE"TC$;15690 RETURN15700 REM === BRIGANDS ===15710 PRINTCS$RD$"BRIGANDS!"TC$:PRINT15720 A=INT(WR/2):IFA<1THENA=115730 LO=WR:HI=LO+A:GOSUB12920:BW=INT(R)15740 PW=WR15750 REM === COMBAT ===15760 B0$=MID$(STR$(BW),2):W0$=MID$(STR$(PW),2)15770 GOSUB11190:REM BATTLE CHARGE SOUND15780 GOSUB12950:REM PERCENTILE ROLL15790 REM === BATTLE! ===15800 CO%=2+(R>(PW/(PW+BW))*100)15810 ONCO%GOTO15820,1585015820 PW=PW-1:REM LOSE A WARRIOR15830 SC%=SC%-1:REM ADJUST SCORE15840 GOTO1587015850 BK=INT(BW/2):BW=BW-BK+(BK<1):REM REDUCE ENEMY ARMY BY 1/215860 SC%=SC%+BK:REM ADJUST SCORE15870 PRINTRL$"ENEMY:"H3$MID$(STR$(BW),2)TC$"/"B0$;15880 PRINTBL$" YOU:"H3$MID$(STR$(PW),2)TC$"/"W0$" ";15890 ONCO%GOSUB11390,11300:REM PLAYER OR ENEMY LOSS SOUND15900 IFPW<=0ORBW<=0THENGOTO1610015910 PRINTTC$RN$H1$"F"RF$TC$"IGHT";15920 IFPW<2THENPRINTH3$"!!! "TC$;15930 IFPW>1THENPRINT" "RN$H1$"R"RF$TC$"ETREAT ";15940 AA$="F":IFPW>1THENAA$=AA$+"R"15950 GOSUB1317015960 IFA$="R"THENGOTO1598015970 GOTO15780:REM LOOP15980 REM === RETREAT FROM COMBAT ===15990 LW=WR-PW:WR=PW16000 PRINT:PRINTYW$"RETREAT! "TC$:PRINT16010 FL=1:WR=WR-FL::REM SUFFER ONE CASUALTY16020 GOSUB13830:REM ADJUST GOLD CARRIED16030 PRINTH1$MID$(STR$(FL),2)TC$" ";:WR%=FL:GOSUB1331016040 PRINT" PERISHED IN THE RETREAT"16050 GOSUB10700:REM RETREAT MUSIC