13590 FC=INT(WR/15):IFFC<1THENFC=113600 FD=FD-FC:IFFD<0THENFD=013610 RETURN13620 REM === IS FOOD LOW? ===13630 LF%=(5>FD-INT(WR/15+.5)):REM SET LF% FLAG IF LESS THAN FIVE FOOD REMAINING13640 RETURN13650 REM === STARVATION ===13660 GOSUB13620:IFLF%THENGOSUB12170:REM STARVATION SOUND13670 IFFD>0THENRETURN13680 PRINTRD$"STARVATION! "TC$;13690 GOSUB10700:REM FUNERAL MARCH SOUND13700 LS=1:WR=WR-LS:GOSUB13830:REM ADJUST GOLD CARRIED13710 PRINT"LOST "YW$MID$(STR$(LS),2)TC$" ";:WR%=LS:GOSUB13310:PRINT"!"13720 GOSUB1376013730 IFWR<=0THENGOSUB12980:REM HIT RETURN TO CONTINUE13740 IFWR>0THENDL=2:GOSUB1005013750 RETURN13760 REM === ARMY ELIMINATED CHECK ===13770 IFWR<1THENWR=0:GM%=3:REM GAME OVER IN PROGRESS13780 IFWR=0THENPRINTRD$"DEFEAT!"TC$" THY WHOLE ARMY HAS PERISHED"13790 RETURN13800 TU%=TU%-1:REM DECREMENT TURN COUNTER13810 FD=FD+FC:REM RESTORE CONSUMED FOOD13820 RETURN13830 REM === ADJUST CARRIED GOLD ===13840 MX=WR*6:IFBS=1THENMX=MX+5013850 IFGD>MXTHENGD=MX13860 RETURN13870 REM === GOLD TREASURE CHECK ===13880 G=0:GOSUB12950:REM ROLL FOR GOLD13890 IFR>TRTHENGOTO13930:REM PROCEED TO RE-ROLL FOR NON-GOLD TREASURE13900 LO=GL%:HI=GH%:GOSUB12920:G=INT(R):REM COMPUTE AMOUNT OF GOLD FOUND13910 GD=GD+G:GOSUB1383013920 PRINTH1$MID$(STR$(G),2)TC$" GOLD GAINED"13930 REM === NON-GOLD TREASURE CHECK ===13940 GOSUB14040:IFKP<>0THENGOSUB16910:GOTO14020:REM KEY IS PRESENT HERE13950 IFTR>0THENTR=2513960 GOSUB12950:REM PERCENTILE ROLL FOR TREASURE13970 IFR>TRTHENGOTO14020:REM NO TREASURE FOUND13980 GOSUB12950:REM PERCENTILE ROLL FOR TREASURE TYPE13990 IFR<=(100/3)ANDPG=0THENGOSUB17040:GOTO14020:REM PEGASUS FOUND14000 IFR<=(200/3)ANDSW=0THENGOSUB17000:GOTO14020:REM DRAGONSWORD FOUND14010 IFWZ=0THENGOSUB17090:REM WIZARD FOUND14020 TR=-1:REM SPECIFY THAT A TREASURE CHECK FOR THE TURN HAS OCCURRED14030 RETURN14040 REM === IS THERE A KEY AT THIS LOCATION? ===14050 KP=0:IFCK=HKOR(KY(1)+KY(2)+KY(3))=3THENRETURN14060 GOSUB13020:IFKI(CK)=CITHENKP=114070 RETURN14080 REM === ROBBED ===14090 SG=0:IFGD>0THENSG=INT(GD/4):IFSG<1THENSG=114100 SL=0:IFWR>1THENSL=INT(WR/4):IFSL<1THENSL=114110 IFSL+SG<1THENGOTO1419014120 GD=GD-SG:IFGD<0THENGD=014130 IFSL>0THENWR=WR-SL:GOSUB13830:REM ADJUST GOLD CARRIED14140 IFSL>0THENPRINTH1$MID$(STR$(SL),2)TC$" ";:WR%=SL:GOSUB1331014150 IFSG>0ANDSL>0THENPRINT" AND ";14160 IFSG>0THENPRINTH1$MID$(STR$(SG),2)TC$" GOLD";14170 PRINT" LOST"14180 GOSUB12980:REM HIT RETURN TO CONTINUE14190 RETURN14200 REM === AWARDED ===14210 LO=17:HI=EW:GOSUB12920:WG%=INT(R/4):WR=WR+WG%14220 PRINTH3$MID$(STR$(WG%),2)TC$" ";:WR%=WG%:GOSUB1331014230 MX=WR*6:IFBS=1THENMX=MX+5014240 IFGD>=MXTHENGOTO1428014250 LO=0:HI=(MX-GD)/4:GOSUB12920:GG%=INT(R)14260 IFGG%>0THENGD=GD+GG%:PRINT" AND "H1$MID$(STR$(GG%),2)TC$" GOLD";14270 PRINT" GAINED";14280 PRINT14290 GOSUB12980:REM HIT RETURN TO CONTINUE14300 RETURN14310 REM === MAIN DISPLAY ===14320 GOSUB13050:REM DERIVE LOCATION INFO14330 FORY=3TO0STEP-1:MP$(3-Y)="":PRINT".";14340 FORX=0TO4:CI=Y*5+X14350 VI=TE(CK,CI)AND128:VT=TE(CK,CI)AND3114360 IFVT<>0THENC$=GD$:IFVI<>0THENC$=GL$:REM DETERMINE COLOR OF BUILDING14370 IFVT=0THENC$=GD$:IFVI<>0THENC$=GL$:REM DETERMINE COLOR OF NON-BUILDING14380 IFVI=0ANDCK<>HKTHENC$=C$+UK$:GOTO14450:REM UNCHARTED TERRITORY14390 IFVT=0THENC$=C$+".":GOTO14450:REM TERRAIN14400 IFVT=1THENC$=C$+RN$+"C"+RF$:GOTO14450:REM CITADEL14410 IFVT=2THENC$=C$+RN$+"S"+RF$:GOTO14450:REM SANCTUARY14420 IFVT=4THENC$=C$+RN$+"B"+RF$:GOTO14450:REM BAZAAR14430 IFVT=8THENC$=C$+RN$+"T"+RF$:GOTO14450:REM TOMB14440 IFVT=16THENC$=C$+RN$+"R"+RF$:REM RUIN14450 IFCK=DD(0)ANDX+1=DD(1)ANDY+1=DD(2)THENC$=RD$+DR$:REM DRAGON14460 IFX+1=PXANDY+1=PYTHENC$=YW$+PW$+TC$:REM WARRIOR14470 MP$(3-Y)=MP$(3-Y)+C$14480 NEXTX14490 MP$(3-Y)=MP$(3-Y)+"  "14500 ONY+1GOTO14610,14570,14530,1451014510 MP$(3-Y)=MP$(3-Y)+H4$+"MAP LEGEND:"14520 GOTO1463014530 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"B"+RF$+TC$+":BAZAAR    "14540 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"C"+RF$+TC$+":CITADEL "14550 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"R"+RF$+TC$+":RUIN"14560 GOTO1463014570 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"S"+RF$+TC$+":SANCTUARY "14580 MP$(3-Y)=MP$(3-Y)+TC$+RN$+"T"+RF$+TC$+":TOMB    "14590 MP$(3-Y)=MP$(3-Y)+YW$+PW$+TC$+":ARMY"14600 GOTO1463014610 MP$(3-Y)=MP$(3-Y)+TC$+"."+TC$+":TERRAIN   "14620 MP$(3-Y)=MP$(3-Y)+GD$+UK$+TC$+":UNKNOWN "+RD$+DR$+TC$+":DRAGON"14630 NEXTY14640 PRINTCS$CHR$(KC(CK))RN$SP$RF$;14650 C1$=RN$+CHR$(KT(CK))+KN$(CK)+RF$+TC$+" ["+MID$(STR$(PX),2)+","14660 C1$=C1$+MID$(STR$(PY),2)+"] "+H4$+LO$+TC$:A=40-LEN(C1$)14670 C2$=TC$+"TURN:"+MID$(STR$(TU%+1),2):A=A-LEN(C2$)+714680 C1$=C1$+LEFT$(SP$,A)+C2$14690 PRINTC1$;14700 PRINTCHR$(KC(CK))RN$SP$RF$;14710 FORI=0TO3:PRINTMP$(I):NEXTI14720 PRINT14730 PRINT"     "RN$H1$"N"RF$TC$"ORTH";14740 KT$="            ":REM EMPTY KEY NAME PLACEHOLDER14750 IFKY(1)=1THENKI%=0:GOSUB13260:KT$=LEFT$(KT$+"      ",13)14760 PRINT"       "KT$;14770 PRINTTC$"ARMY:";14780 GOSUB13520:IFLW%THENPRINTRN$;14790 PRINTRL$MID$(STR$(WR),2)TC$14800 IFLW%THENPRINTRF$;14810 PRINTRN$H1$"W"RF$TC$"EST";14820 C$="       ":IFLO$<>"TERRAIN"THENC$=" EN"+H1$+RN$+"T"+RF$+TC$+"ER "14830 PRINTC$RN$H1$"E"RF$TC$"AST";14840 KT$="            ":REM EMPTY KEY NAME PLACEHOLDER14850 IFKY(2)=1THENKI%=1:GOSUB13260:KT$=LEFT$(KT$+"     ",13)14860 PRINT"  "KT$;14870 PRINTTC$"FOOD:";14880 GOSUB13620:IFLF%THENPRINTRN$;14890 PRINTLG$MID$(STR$(INT(FD)),2)TC$14900 IFLF%THENPRINTRF$;14910 PRINT"     "RN$H1$"S"RF$TC$"OUTH";14920 KT$="            ":REM EMPTY KEY NAME PLACEHOLDER14930 IFKY(3)=1THENKI%=2:GOSUB13260:KT$=LEFT$(KT$+"       ",13)14940 PRINT"       "KT$;14950 PRINTTC$"GOLD:";14960 GOSUB13550:IFLG%THENPRINTRN$;14970 PRINTYW$MID$(STR$(GD),2)TC$14980 IFLG%THENPRINTRF$;14990 GOSUB1334015000 RETURN15010 REM === ACTION PROMPT ===15020 PRINT:A$="":PRINTH4$"CHOOSE: "TC$;15030 AA$=BA$+"NSWE"15040 IFLO$<>"TERRAIN"THENAA$=AA$+"T"15050 IFPG=1THENAA$=AA$+"P"15060 IFWZ=1THENAA$=AA$+"Z"15070 GOSUB13170:PRINT:AX$=A$15080 T